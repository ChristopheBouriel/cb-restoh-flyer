---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = "RestOh — Restaurant Management SaaS by Christophe Bouriel",
  description = "A complete restaurant management SaaS application built with React, Node.js, and MongoDB. Features 2,000+ tests, 84% coverage, and enterprise-grade security."
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="restaurant management, SaaS, React, Node.js, MongoDB, full-stack developer, Christophe Bouriel" />
    <meta name="author" content="Christophe Bouriel" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://restoh.christophebouriel.dev" />
    <meta property="og:title" content="RestOh — Restaurant Management SaaS" />
    <meta property="og:description" content="A complete restaurant management SaaS application. 2,000+ tests, production-ready." />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="RestOh — Restaurant Management SaaS" />
    <meta name="twitter:description" content="A complete restaurant management SaaS application by Christophe Bouriel." />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href="https://restoh.christophebouriel.dev" />

    <!-- Fonts - Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-bg-primary text-fg-primary antialiased">
    <slot />
  </body>
</html>
